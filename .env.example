# Токен бота от @BotFather
BOT_TOKEN=
# Ваш Telegram ID (узнать: @userinfobot). Несколько — через запятую.
ADMIN_IDS=
# API-ключ Grizzly SMS: grizzlysms.com → Кабинет → Настройки
GRIZZLY_API_KEY=
# Валюта баланса в Grizzly: RUB или USD (если USD — цены переводятся по курсу USD_RUB_RATE)
GRIZZLY_CURRENCY=RUB
USD_RUB_RATE=95

# Название бота в главном меню
BOT_NAME=SMS Number Bot
# Поддержка (username без @) и ссылка на канал — необязательно
SUPPORT_USERNAME=
CHANNEL_URL=

# Наценка: 2 = цена в 2 раза выше закупочной
MARKUP=2

# CryptoBot: @CryptoBot → Crypto Pay → Create App → API Token
CRYPTOPAY_TOKEN=
CRYPTOPAY_TESTNET=0

# Telegram Stars: сколько рублей стоит 1 звезда
STAR_RUB_RATE=1.8

# Cryptomus (оплата криптой на адрес: USDT TRC20/BEP20/TON, TON, BTC, LTC, ETH, TRX)
# cryptomus.com → Бизнес → Мерчант → Настройки: Merchant ID и Payment API key
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=

# ЮMoney: оплата картой Мир/Visa/Mastercard и с кошелька ЮMoney на ваш кошелёк.
# Номер кошелька и токен заполняются автоматически командой: sudo smsbot yoomoney
YOOMONEY_WALLET=
YOOMONEY_TOKEN=

# Оплата картой в рублях: @BotFather → ваш бот → Payments → ЮKassa → токен
PAYMENT_PROVIDER_TOKEN=

MIN_TOPUP_RUB=50
ORDER_TIMEOUT_MIN=20
DB_PATH=bot.db
